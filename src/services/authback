
import api from "./api";

// ============================================================
// AUTH STORAGE KEYS
// ============================================================

const ACCESS_TOKEN_KEY = "access_token";
const REFRESH_TOKEN_KEY = "refresh_token";
const USER_KEY = "user";

// ============================================================
// STORAGE HELPERS
// ============================================================

const getActiveStorage = () => {
  if (
    localStorage.getItem(ACCESS_TOKEN_KEY) ||
    localStorage.getItem(REFRESH_TOKEN_KEY)
  ) {
    return localStorage;
  }

  if (
    sessionStorage.getItem(ACCESS_TOKEN_KEY) ||
    sessionStorage.getItem(REFRESH_TOKEN_KEY)
  ) {
    return sessionStorage;
  }

  return null;
};

// ============================================================
// NORMALIZE USER
// ============================================================
// Ensures permissions always exists as an array.
// Also normalizes permission values to strings.
// ============================================================

const normalizeUser = (user) => {
  if (!user || typeof user !== "object") {
    return null;
  }

  let permissions = [];

  if (Array.isArray(user.permissions)) {
    permissions = user.permissions
      .map((permission) => {
        // If backend returns:
        // { id: 1, code: "sales.create_sale" }
        if (permission && typeof permission === "object") {
          return (
            permission.code ||
            permission.permission ||
            permission.codename ||
            permission.name ||
            null
          );
        }

        return permission;
      })
      .filter(Boolean)
      .map(String);
  }

  return {
    ...user,
    permissions,
  };
};

// ============================================================
// AUTH SERVICE
// ============================================================

const authApi = {
  // ==========================================================
  // LOGIN
  // ==========================================================

  login: async (credentials, rememberMe = false) => {
    const response = await api.post(
      "/auth/login/",
      credentials
    );

    const data = response.data;

    // --------------------------------------------------------
    // Get access token
    // --------------------------------------------------------

    const accessToken =
      data.access || data.access_token;

    // --------------------------------------------------------
    // Get refresh token
    // --------------------------------------------------------

    const refreshToken =
      data.refresh || data.refresh_token;

    if (!accessToken) {
      throw new Error(
        "Login successful, but no access token was returned."
      );
    }

    // --------------------------------------------------------
    // Clear old authentication
    // --------------------------------------------------------

    authApi.clearStorage();

    // --------------------------------------------------------
    // Select storage
    // --------------------------------------------------------

    const storage = rememberMe
      ? localStorage
      : sessionStorage;

    // --------------------------------------------------------
    // Store access token
    // --------------------------------------------------------

    storage.setItem(
      ACCESS_TOKEN_KEY,
      accessToken
    );

    // --------------------------------------------------------
    // Store refresh token
    // --------------------------------------------------------

    if (refreshToken) {
      storage.setItem(
        REFRESH_TOKEN_KEY,
        refreshToken
      );
    }

    // --------------------------------------------------------
    // IMPORTANT
    // --------------------------------------------------------
    // Do not rely only on data.user from login.
    //
    // We fetch /auth/me/ after login so that we get:
    //
    // id
    // username
    // role
    // branch
    // permissions
    // is_superuser
    // etc.
    // --------------------------------------------------------

    let user = null;

    try {
      const userResponse = await api.get(
        "/auth/me/"
      );

      user = normalizeUser(
        userResponse.data
      );

      if (user) {
        authApi.setUser(user);
      }
    } catch (error) {
      // ------------------------------------------------------
      // Fallback to user returned by login
      // ------------------------------------------------------

      if (data.user) {
        user = normalizeUser(
          data.user
        );

        authApi.setUser(user);
      } else {
        throw error;
      }
    }

    // --------------------------------------------------------
    // Return complete login response
    // --------------------------------------------------------

    return {
      ...data,
      user,
    };
  },

  // ==========================================================
  // LOGOUT
  // ==========================================================

  logout: async () => {
    try {
      const refreshToken =
        authApi.getRefreshToken();

      if (refreshToken) {
        await api.post(
          "/auth/logout/",
          {
            refresh: refreshToken,
          }
        );
      }
    } catch (error) {
      console.warn(
        "Logout API request failed:",
        error
      );
    } finally {
      authApi.clearStorage();
    }

    return true;
  },

  // ==========================================================
  // GET CURRENT USER
  // ==========================================================

  getCurrentUser: async () => {
    const response = await api.get(
      "/auth/me/"
    );

    const user = normalizeUser(
      response.data
    );

    if (user) {
      authApi.setUser(user);
    }

    return user;
  },

  // ==========================================================
  // REFRESH ACCESS TOKEN
  // ==========================================================

  refreshToken: async () => {
    const refreshToken =
      authApi.getRefreshToken();

    if (!refreshToken) {
      throw new Error(
        "No refresh token available."
      );
    }

    const response = await api.post(
      "/auth/refresh/",
      {
        refresh: refreshToken,
      }
    );

    const data = response.data;

    const accessToken =
      data.access || data.access_token;

    if (!accessToken) {
      throw new Error(
        "No access token returned."
      );
    }

    // --------------------------------------------------------
    // Store new access token
    // --------------------------------------------------------

    authApi.setAccessToken(
      accessToken
    );

    // --------------------------------------------------------
    // Handle rotated refresh token
    // --------------------------------------------------------

    const newRefreshToken =
      data.refresh || data.refresh_token;

    if (newRefreshToken) {
      authApi.setRefreshToken(
        newRefreshToken
      );
    }

    // --------------------------------------------------------
    // Refresh user permissions too
    // --------------------------------------------------------
    // This is useful if an administrator changes the user's
    // permissions while the user is logged in.
    // --------------------------------------------------------

    try {
      await authApi.getCurrentUser();
    } catch (error) {
      console.warn(
        "Failed to refresh current user:",
        error
      );
    }

    return data;
  },

  // ==========================================================
  // GET ACCESS TOKEN
  // ==========================================================

  getAccessToken: () => {
    return (
      localStorage.getItem(
        ACCESS_TOKEN_KEY
      ) ||
      sessionStorage.getItem(
        ACCESS_TOKEN_KEY
      )
    );
  },

  // ==========================================================
  // GET REFRESH TOKEN
  // ==========================================================

  getRefreshToken: () => {
    return (
      localStorage.getItem(
        REFRESH_TOKEN_KEY
      ) ||
      sessionStorage.getItem(
        REFRESH_TOKEN_KEY
      )
    );
  },

  // ==========================================================
  // SET ACCESS TOKEN
  // ==========================================================

  setAccessToken: (token) => {
    if (!token) {
      return;
    }

    const storage =
      getActiveStorage();

    if (storage) {
      storage.setItem(
        ACCESS_TOKEN_KEY,
        token
      );

      return;
    }

    localStorage.setItem(
      ACCESS_TOKEN_KEY,
      token
    );
  },

  // ==========================================================
  // SET REFRESH TOKEN
  // ==========================================================

  setRefreshToken: (token) => {
    if (!token) {
      return;
    }

    const storage =
      getActiveStorage();

    if (storage) {
      storage.setItem(
        REFRESH_TOKEN_KEY,
        token
      );

      return;
    }

    localStorage.setItem(
      REFRESH_TOKEN_KEY,
      token
    );
  },

  // ==========================================================
  // GET STORED USER
  // ==========================================================

  getUser: () => {
    const user =
      localStorage.getItem(USER_KEY) ||
      sessionStorage.getItem(USER_KEY);

    if (!user) {
      return null;
    }

    try {
      return normalizeUser(
        JSON.parse(user)
      );
    } catch (error) {
      console.error(
        "Failed to parse stored user:",
        error
      );

      return null;
    }
  },

  // ==========================================================
  // SET USER
  // ==========================================================

  setUser: (user) => {
    if (!user) {
      return;
    }

    const normalizedUser =
      normalizeUser(user);

    const storage =
      getActiveStorage();

    if (storage) {
      storage.setItem(
        USER_KEY,
        JSON.stringify(
          normalizedUser
        )
      );

      return;
    }

    localStorage.setItem(
      USER_KEY,
      JSON.stringify(
        normalizedUser
      )
    );
  },

  // ==========================================================
  // IS AUTHENTICATED
  // ==========================================================

  isAuthenticated: () => {
    return Boolean(
      authApi.getAccessToken()
    );
  },

  // ==========================================================
  // CLEAR AUTH STORAGE
  // ==========================================================

  clearStorage: () => {
    // --------------------------------------------------------
    // Local storage
    // --------------------------------------------------------

    localStorage.removeItem(
      ACCESS_TOKEN_KEY
    );

    localStorage.removeItem(
      REFRESH_TOKEN_KEY
    );

    localStorage.removeItem(
      USER_KEY
    );

    // --------------------------------------------------------
    // Session storage
    // --------------------------------------------------------

    sessionStorage.removeItem(
      ACCESS_TOKEN_KEY
    );

    sessionStorage.removeItem(
      REFRESH_TOKEN_KEY
    );

    sessionStorage.removeItem(
      USER_KEY
    );
  },

  // ==========================================================
  // GET USER ROLE
  // ==========================================================

  getRole: () => {
    const user =
      authApi.getUser();

    return user?.role || null;
  },

  // ==========================================================
  // GET USER ROLE NAME
  // ==========================================================

  getRoleName: () => {
    const user =
      authApi.getUser();

    return user?.role_name || null;
  },

  // ==========================================================
  // GET USER BRANCH
  // ==========================================================

  getBranch: () => {
    const user =
      authApi.getUser();

    return user?.branch || null;
  },

  // ==========================================================
  // CHECK ROLE
  // ==========================================================

  hasRole: (role) => {
    const user =
      authApi.getUser();

    if (!user || !role) {
      return false;
    }

    return user.role === role;
  },

  // ==========================================================
  // CHECK ANY ROLE
  // ==========================================================

  hasAnyRole: (roles = []) => {
    const user =
      authApi.getUser();

    if (
      !user ||
      !Array.isArray(roles)
    ) {
      return false;
    }

    return roles.includes(
      user.role
    );
  },

  // ==========================================================
  // GET USER PERMISSIONS
  // ==========================================================

  getPermissions: () => {
    const user =
      authApi.getUser();

    if (!user) {
      return [];
    }

    if (
      user.is_superuser
    ) {
      return ["*"];
    }

    return Array.isArray(
      user.permissions
    )
      ? user.permissions
      : [];
  },

  // ==========================================================
  // CHECK SINGLE PERMISSION
  // ==========================================================

  hasPermission: (permission) => {
    const user =
      authApi.getUser();

    if (
      !user ||
      !permission
    ) {
      return false;
    }

    // --------------------------------------------------------
    // Superuser
    // --------------------------------------------------------

    if (user.is_superuser) {
      return true;
    }

    // --------------------------------------------------------
    // Permissions
    // --------------------------------------------------------

    const userPermissions =
      Array.isArray(
        user.permissions
      )
        ? user.permissions
        : [];

    return userPermissions.includes(
      String(permission)
    );
  },

  // ==========================================================
  // CHECK ANY PERMISSION
  // ==========================================================

  hasAnyPermission: (permissions = []) => {
    const user =
      authApi.getUser();

    if (
      !user ||
      !Array.isArray(permissions)
    ) {
      return false;
    }

    // --------------------------------------------------------
    // Superuser
    // --------------------------------------------------------

    if (user.is_superuser) {
      return true;
    }

    // --------------------------------------------------------
    // User permissions
    // --------------------------------------------------------

    const userPermissions =
      Array.isArray(
        user.permissions
      )
        ? user.permissions
        : [];

    if (
      userPermissions.length === 0
    ) {
      return false;
    }

    return permissions.some(
      (permission) =>
        userPermissions.includes(
          String(permission)
        )
    );
  },

  // ==========================================================
  // CHECK ALL PERMISSIONS
  // ==========================================================

  hasAllPermissions: (permissions = []) => {
    const user =
      authApi.getUser();

    if (
      !user ||
      !Array.isArray(permissions)
    ) {
      return false;
    }

    // --------------------------------------------------------
    // Superuser
    // --------------------------------------------------------

    if (user.is_superuser) {
      return true;
    }

    // --------------------------------------------------------
    // User permissions
    // --------------------------------------------------------

    const userPermissions =
      Array.isArray(
        user.permissions
      )
        ? user.permissions
        : [];

    if (
      userPermissions.length === 0
    ) {
      return false;
    }

    return permissions.every(
      (permission) =>
        userPermissions.includes(
          String(permission)
        )
    );
  },

  // ==========================================================
  // CHECK IF USER HAS ANY PERMISSIONS
  // ==========================================================

  hasPermissions: () => {
    const user =
      authApi.getUser();

    if (!user) {
      return false;
    }

    if (user.is_superuser) {
      return true;
    }

    return (
      Array.isArray(
        user.permissions
      ) &&
      user.permissions.length > 0
    );
  },

  // ==========================================================
  // GET AUTH DEBUG INFORMATION
  // ==========================================================
  // Useful while debugging permission problems.
  // ==========================================================

  getAuthDebug: () => {
    const user =
      authApi.getUser();

    return {
      authenticated:
        authApi.isAuthenticated(),

      userId:
        user?.id || null,

      username:
        user?.username || null,

      role:
        user?.role || null,

      roleName:
        user?.role_name || null,

      branch:
        user?.branch || null,

      isSuperuser:
        Boolean(
          user?.is_superuser
        ),

      permissions:
        Array.isArray(
          user?.permissions
        )
          ? user.permissions
          : [],

      permissionCount:
        Array.isArray(
          user?.permissions
        )
          ? user.permissions.length
          : 0,
    };
  },
};

export default authApi;
