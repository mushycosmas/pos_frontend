
import React from 'react';
import { NavLink } from 'react-router-dom';
import { useAuth } from '../../context/AuthContext';

const Sidebar = () => {
  const { hasPermission } = useAuth();

  // ============================================================
  // MENU CONFIGURATION
  // ============================================================
  //
  // `permission` controls whether the menu item is displayed.
  //
  // IMPORTANT:
  // This only controls the FRONTEND UI.
  // The Django backend MUST also enforce the same permissions.
  //
  const menuItems = [
    // ==========================================================
    // MAIN
    // ==========================================================
    {
      section: 'MAIN',
      items: [
        {
          name: 'Dashboard',
          icon: 'bi-grid-1x2-fill',
          path: '/dashboard',
          permission: 'dashboard.view_dashboard',
        },
        {
          name: 'POS / Sales',
          icon: 'bi-cart3',
          path: '/pos',
          permission: 'sales.create_sale',
        },
      ],
    },

    // ==========================================================
    // SALES
    // ==========================================================
    {
      section: 'SALES',
      items: [
        {
          name: 'Sales',
          icon: 'bi-receipt',
          path: '/sales',
          permission: 'sales.view_sale',
        },
        {
          name: 'Customers',
          icon: 'bi-people',
          path: '/customers',
          permission: 'customers.view_customer',
        },
        {
          name: 'Returns',
          icon: 'bi-arrow-return-left',
          path: '/returns',
          permission: 'sales.return_sale',
        },
      ],
    },

    // ==========================================================
    // INVENTORY
    // ==========================================================
    {
      section: 'INVENTORY',
      items: [
        {
          name: 'Products',
          icon: 'bi-box-seam',
          path: '/products',
          permission: 'products.view_product',
        },
        {
          name: 'Inventory',
          icon: 'bi-stack',
          path: '/inventory',
          permission: 'inventory.view_stock',
        },
        {
          name: 'Categories',
          icon: 'bi-tags',
          path: '/categories',
          permission: 'categories.view_category',
        },
        {
          name: 'Brands',
          icon: 'bi-award',
          path: '/brands',
          permission: 'brands.view_brand',
        },
        {
          name: 'Purchases',
          icon: 'bi-bag-plus',
          path: '/purchases',
          permission: 'purchases.view_purchase',
        },
        {
          name: 'Suppliers',
          icon: 'bi-truck',
          path: '/suppliers',
          permission: 'suppliers.view_supplier',
        },
        {
          name: 'Stock Adjustments',
          icon: 'bi-sliders',
          path: '/stock-adjustments',
          permission: 'inventory.adjust_stock',
        },
      ],
    },

    // ==========================================================
    // FINANCE
    // ==========================================================
    {
      section: 'FINANCE',
      items: [
        {
          name: 'Expenses',
          icon: 'bi-wallet2',
          path: '/expenses',
          permission: 'expenses.view_expense',
        },
        {
          name: 'Payments',
          icon: 'bi-credit-card',
          path: '/payments',
          permission: 'payments.view_payment',
        },
        {
          name: 'Cash Management',
          icon: 'bi-cash-stack',
          path: '/cash-management',
          permission: 'cash_management.view_cash',
        },
      ],
    },

    // ==========================================================
    // REPORTS
    // ==========================================================
    {
      section: 'REPORTS',
      items: [
        {
          name: 'Sales Reports',
          icon: 'bi-bar-chart-line',
          path: '/reports/sales',
          permission: 'reports.view_sales_report',
        },
        {
          name: 'Inventory Reports',
          icon: 'bi-clipboard-data',
          path: '/reports/inventory',
          permission: 'reports.view_inventory_report',
        },
        {
          name: 'Expense Reports',
          icon: 'bi-file-earmark-bar-graph',
          path: '/reports/expenses',
          permission: 'reports.view_expense_report',
        },
        {
          name: 'Profit & Loss',
          icon: 'bi-graph-up-arrow',
          path: '/reports/profit-loss',
          permission: 'reports.view_profit_loss',
        },
      ],
    },

    // ==========================================================
    // SYSTEM
    // ==========================================================
    {
      section: 'SYSTEM',
      items: [
        {
          name: 'Users',
          icon: 'bi-people-fill',
          path: '/users',
          permission: 'users.view_user',
        },
        {
          name: 'Roles & Permissions',
          icon: 'bi-shield-lock',
          path: '/roles',
          permission: 'roles.view_role',
        },
        {
          name: 'Payment Methods',
          icon: 'bi-credit-card-2-front',
          path: '/payment-methods',
          permission: 'payments.view_payment_method',
        },
        {
          name: 'Settings',
          icon: 'bi-gear',
          permission: 'settings.view_setting',
          path: '/settings',
        },
      ],
    },
  ];

  // ============================================================
  // FILTER MENU BY PERMISSION
  // ============================================================
  const visibleMenuGroups = menuItems
    .map((group) => {
      const visibleItems = group.items.filter((item) => {
        // If no permission is specified, show the item.
        if (!item.permission) {
          return true;
        }

        return hasPermission(item.permission);
      });

      return {
        ...group,
        items: visibleItems,
      };
    })
    // Remove sections that have no visible menu items
    .filter((group) => group.items.length > 0);

  return (
    <aside className="sidebar">

      {/* ======================================================
          BRAND
      ====================================================== */}
      <div className="brand">

        <div className="brand-icon">
          <i className="bi bi-shop"></i>
        </div>

        <div>
          <div className="brand-name">
            POS SYSTEM
          </div>

          <small>
            Retail Management
          </small>
        </div>

      </div>

      {/* ======================================================
          MENU
      ====================================================== */}
      <div className="sidebar-menu">

        {visibleMenuGroups.map((group) => (

          <div
            className="menu-group"
            key={group.section}
          >

            {/* SECTION TITLE */}
            <div className="menu-title">
              {group.section}
            </div>

            {/* MENU ITEMS */}
            {group.items.map((item) => (

              <NavLink
                key={item.name}
                to={item.path}
                className={({ isActive }) =>
                  `menu-item ${isActive ? 'active' : ''}`
                }
              >

                <i
                  className={`bi ${item.icon}`}
                ></i>

                <span>
                  {item.name}
                </span>

              </NavLink>

            ))}

          </div>

        ))}

      </div>

      {/* ======================================================
          FOOTER
      ====================================================== */}
      <div className="sidebar-footer">

        <div className="store-status">

          <span className="status-dot"></span>

          <div>

            <strong>
              Store Online
            </strong>

            <small>
              System operational
            </small>

          </div>

        </div>

      </div>

    </aside>
  );
};

export default Sidebar;